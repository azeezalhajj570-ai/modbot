# ModBot
BOT_APP_KIND=admin
ADMIN_BOT_TOKEN=your_admin_bot_token
BOT_TOKEN=fallback_token

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modbot
# For local dev without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./modbot.sqlite3

# Redis
REDIS_URL=redis://localhost:6379/0

# Language (ar = Arabic, en = English)
DEFAULT_LANGUAGE=ar

# Logging
LOG_LEVEL=INFO
AIROGRAM_LOG_LEVEL=WARNING
LOG_RAW_UPDATES=false

# WebApp URLs
ADMIN_WEBAPP_URL=http://localhost:5173
WEBAPP_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# Dashboard JWT
DASHBOARD_JWT_SECRET=change-me-in-production
TELEGRAM_LOGIN_BOT_USERNAME=YourModBot

# Browser dashboard auth (JSON array of {username, password, role})
DASHBOARD_BROWSER_USERS=[{"username":"admin","password":"changeme","role":"owner"}]

# AI Providers (optional — required for AI moderation and FAQ)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Stripe (optional — required for paid subscriptions)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Sentry (optional)
SENTRY_DSN=

# Telegram API (required for agent/userbot accounts)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SESSION_ENCRYPTION_KEY=

# Bot owner Telegram user IDs (comma-separated)
BOT_OWNER_IDS=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=25

# Features
AI_RECEPTIONIST_ENABLED=false
DAILY_SUMMARY_ENABLED=false
RUN_SCHEMA_BOOTSTRAP=false
